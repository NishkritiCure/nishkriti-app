pnpm lint-staged
pnpm tsc --noEmit

# If any backend migration file changed, regenerate Supabase types.
# (Migrations live in the backend repo, not here, so this is a safety net for
# local schema tinkering. CI handles the canonical regeneration.)
if git diff --cached --name-only | grep -q '^supabase/migrations/'; then
  pnpm run types:db
  git add src/types/database.types.ts
fi
